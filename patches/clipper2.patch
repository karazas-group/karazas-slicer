-// Reverse a linked loop of points representing a closed polygon.
-// This has a time complexity of O(n)
-void ReversePolyPtLinks(OutPt *pp)
-{
-  if (!pp) return;
-  OutPt *pp1 = pp;
-  do {
-    OutPt *pp2 = pp1->Next;
-    pp1->Next = pp1->Prev;
-    pp1->Prev = pp2;
-    pp1 = pp2;
-  } while( pp1 != pp );
-}
