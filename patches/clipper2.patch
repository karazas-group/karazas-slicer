-          if (!d) return -1;
-          if ((d > 0) == (op->Next->Pt.y() > op->Pt.y())) result = 1 - result;
-        }
-      } else
-      {
-        if (op->Next->Pt.x() > pt.x())
-        {
-          auto d = CrossProductType(op->Pt.x() - pt.x()) * CrossProductType(op->Next->Pt.y() - pt.y()) - CrossProductType(op->Next->Pt.x() - pt.x()) * CrossProductType(op->Pt.y() - pt.y());
-          if (!d) return -1;
-          if ((d > 0) == (op->Next->Pt.y() > op->Pt.y())) result = 1 - result;
-        }
-      }
