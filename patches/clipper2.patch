-bool Pt2IsBetweenPt1AndPt3(const IntPoint &pt1,
-  const IntPoint &pt2, const IntPoint &pt3)
-{
-  if ((pt1 == pt3) || (pt1 == pt2) || (pt3 == pt2))
-    return false;
-  else if (pt1.x() != pt3.x())
-    return (pt2.x() > pt1.x()) == (pt2.x() < pt3.x());
-  else
-    return (pt2.y() > pt1.y()) == (pt2.y() < pt3.y());
-}
