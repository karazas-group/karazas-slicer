-double Area(const Path &poly)
-{
-  int size = (int)poly.size();
-  if (size < 3) return 0;
-
-  double a = 0;
-  for (int i = 0, j = size -1; i < size; ++i)
-  {
-    a += ((double)poly[j].x() + poly[i].x()) * ((double)poly[j].y() - poly[i].y());
-    j = i;
-  }
-  return -a * 0.5;
-}
