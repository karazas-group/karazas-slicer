-
-// Karaza: is a lower than b, in GetBottomPt's order (larger y, then smaller x)?
-inline bool KzLower(const IntPoint &a, const IntPoint &b)
-{
-  return a.y() > b.y() || (a.y() == b.y() && a.x() < b.x());
-}
-
-// Karaza: a point added to the ring during the sweep.
-inline void KzAddBot(OutRec *outRec, OutPt *op)
-{
-  if (KzLower(op->Pt, outRec->KzBot)) { outRec->KzBot = op->Pt; outRec->KzBotPt = op; outRec->KzBotCount = 1; }
-  else if (op->Pt == outRec->KzBot) ++ outRec->KzBotCount;
-}
-
-// Karaza: during the sweep (inSweep) a ring with a single point at its lowest coordinate has that
-// point as its GetBottomPt(), so it needn't be walked. Otherwise (several points there, or after
-// the sweep, when JoinCommonEdges and FixupOutPolygon move points) it is walked as before.
-inline OutPt* KzBottomPt(OutRec *outRec, bool inSweep)
-{
-  return inSweep && outRec->KzBotCount == 1 ? outRec->KzBotPt : GetBottomPt(outRec->Pts);
-}
-
-OutRec* GetLowermostRec(OutRec *outRec1, OutRec *outRec2, bool inSweep)
-{
-  //work out which polygon fragment has the correct hole state ...
-  if (!outRec1->BottomPt) 
-    outRec1->BottomPt = KzBottomPt(outRec1, inSweep);
-  if (!outRec2->BottomPt) 
-    outRec2->BottomPt = KzBottomPt(outRec2, inSweep);
-  OutPt *OutPt1 = outRec1->BottomPt;
-  OutPt *OutPt2 = outRec2->BottomPt;
-  if (OutPt1->Pt.y() > OutPt2->Pt.y()) return outRec1;
-  else if (OutPt1->Pt.y() < OutPt2->Pt.y()) return outRec2;
-  else if (OutPt1->Pt.x() < OutPt2->Pt.x()) return outRec1;
-  else if (OutPt1->Pt.x() > OutPt2->Pt.x()) return outRec2;
-  else if (OutPt1->Next == OutPt1) return outRec2;
-  else if (OutPt2->Next == OutPt2) return outRec1;
-  else if (FirstIsBottomPt(OutPt1, OutPt2)) return outRec1;
-  else return outRec2;
-}
