-// Karaza: see ClipperOffset::DoOffset. A path needs this many flat concave corners (cos at or
-// above KZ_FLAT_COS, under about 0.8 degrees) before their spikes are left out. With these
-// values all 28 matrix cases and the 18 pricer cases give the same grams as without the change;
-// a limit of 256 moved Benchy on the S1 with organic supports by 0.18 g.
-static constexpr int    KZ_FLAT_SPIKES = 1024;
-static constexpr double KZ_FLAT_COS    = 0.9999;
