     ThickPolylines thick_polylines_out;
 
+#ifndef KZ_FULL_DETAIL
+    // KZ website build: the pricer needs the plastic, not the beads. Arachne on
+    // these narrow solid strips costs about a fifth of a curved model's slice;
+    // a solid fill lays down its area times the layer height, so emit one
+    // straight path with that volume (area / spacing long at the flow's
+    // mm3_per_mm). Grams match the Arachne fill to a few hundredths of a gram.
+    {
+        double area = 0;
+        for (const ExPolygon &ex : this->no_overlap_expolygons) area += ex.area();
+        const double spacing = params.flow.scaled_spacing();
+        if (area > 0 && spacing > 0 && !this->no_overlap_expolygons.empty()) {
+            const Point a = this->no_overlap_expolygons.front().contour.first_point();
+            ExtrusionPath path(params.extrusion_role, params.flow.mm3_per_mm(), params.flow.width(), params.flow.height());
+            path.polyline.append(Point3(coord_t(a.x()), coord_t(a.y()), coord_t(0)));
+            path.polyline.append(Point3(coord_t(a.x() + coord_t(area / spacing)), coord_t(a.y()), coord_t(0)));
+            ExtrusionEntityCollection *coll = new ExtrusionEntityCollection();
+            coll->no_sort = this->no_sort();
+            coll->append(std::move(path));
+            out.push_back(coll);
+        }
+        return;
+    }
+#endif
