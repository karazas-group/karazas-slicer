+// Karaza: the same matching without the hash table. The table pairs each
+// edge with the earliest still-unmatched edge of another facet that has the
+// same key, and keeps every edge it ever stored in a pool that only grows:
+// about 25 MB on a 225k-triangle model. Sorting the edges by a hash of the
+// key (insertion order breaking ties) and pairing first-in-first-out inside
+// each run of equal keys makes exactly the same pairs in 5 MB, faster.
+// Edges are numbered 3 * facet + edge, the order the table saw them in.
+// Returns false for meshes too big to number in 24 bits; the table does those.
+static bool match_edges_sorted(stl_file *stl)
+{
+	const uint64_t nr_edges = uint64_t(stl->stats.number_of_facets) * 3;
+	if (nr_edges == 0 || nr_edges >= (uint64_t(1) << 24))
+		return false;
+	auto load = [stl](uint32_t e, HashEdge &edge) {
+		const stl_facet &facet = stl->facet_start[e / 3];
+		edge.facet_number = int(e / 3);
+		edge.which_edge   = int(e % 3);
+		edge.load_exact(stl, &facet.vertex[e % 3], &facet.vertex[(e % 3 + 1) % 3]);
+	};
+	std::vector<uint64_t> order(nr_edges);
+	{
+		HashEdge edge;
+		for (uint32_t e = 0; e < nr_edges; ++ e) {
+			load(e, edge); // also keeps stats.shortest_edge, as the table did
+			uint64_t h = 1469598103934665603ull;
+			for (uint32_t k : edge.key)
+				h = (h ^ k) * 1099511628211ull;
+			order[e] = (h << 24) | e;
+		}
+	}
+	std::sort(order.begin(), order.end());
+	std::vector<HashEdge> open; // unmatched edges of one run, oldest first
+	for (size_t b = 0; b < order.size();) {
+		size_t r = b + 1;
+		while (r < order.size() && (order[r] >> 24) == (order[b] >> 24))
+			++ r;
+		if (r - b > 1) {
+			open.clear();
+			for (size_t i = b; i < r; ++ i) {
+				HashEdge edge;
+				load(uint32_t(order[i] & 0xFFFFFF), edge);
+				auto it = std::find_if(open.begin(), open.end(), [&edge](const HashEdge &o) { return o.facet_number != edge.facet_number && o == edge; });
+				if (it == open.end())
+					open.push_back(edge);
+				else {
+					HashTableEdges::record_neighbors(stl, edge, *it);
+					open.erase(it);
+				}
+			}
+		}
+		b = r;
+	}
+	return true;
+}
